{
  "name": "remote-ssh-webform",
  "displayName": "Remote SSH WebForm",
  "description": "Build, run and debug classic ASP.NET (.NET Framework Web Forms / Web API) projects under IIS Express from VS Code Remote-SSH, driven by Visual Studio .slnLaunch profiles, keep Web Forms designer files in sync with the markup, and view DataTables, DataSets, lists and dictionaries as tables while debugging.",
  "version": "0.9.0",
  "publisher": "AriTrikesuma",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "categories": [
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.slnLaunch",
    "workspaceContains:**/*.csproj",
    "workspaceContains:**/*.vbproj",
    "onDebugResolve:clr",
    "onDebugResolve:coreclr"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "remoteSshWebForm.selectProfile",
        "title": "Select Launch Profile",
        "category": "Remote SSH WebForm",
        "icon": "$(server-process)"
      },
      {
        "command": "remoteSshWebForm.build",
        "title": "Build Profile",
        "category": "Remote SSH WebForm"
      },
      {
        "command": "remoteSshWebForm.buildSolution",
        "title": "Build Solution",
        "category": "Remote SSH WebForm",
        "icon": "$(tools)"
      },
      {
        "command": "remoteSshWebForm.run",
        "title": "Run Profile (without debugging)",
        "category": "Remote SSH WebForm",
        "icon": "$(play)"
      },
      {
        "command": "remoteSshWebForm.debug",
        "title": "Debug Profile",
        "category": "Remote SSH WebForm",
        "icon": "$(debug-alt)"
      },
      {
        "command": "remoteSshWebForm.stop",
        "title": "Stop IIS Express",
        "category": "Remote SSH WebForm",
        "icon": "$(debug-stop)"
      },
      {
        "command": "remoteSshWebForm.reload",
        "title": "Reload (rebuild and restart)",
        "category": "Remote SSH WebForm",
        "icon": "$(debug-restart)"
      },
      {
        "command": "remoteSshWebForm.openBrowser",
        "title": "Open Site in Browser",
        "category": "Remote SSH WebForm"
      },
      {
        "command": "remoteSshWebForm.generateDesigner",
        "title": "Regenerate Designer File",
        "category": "Remote SSH WebForm"
      },
      {
        "command": "remoteSshWebForm.toggleCodeBehind",
        "title": "Toggle Markup / Code-Behind",
        "category": "Remote SSH WebForm"
      },
      {
        "command": "remoteSshWebForm.visualizeVariable",
        "title": "Visualize as Table",
        "category": "Remote SSH WebForm",
        "icon": "$(table)"
      },
      {
        "command": "remoteSshWebForm.visualizeExpression",
        "title": "Visualize Expression as Table...",
        "category": "Remote SSH WebForm",
        "icon": "$(table)"
      },
      {
        "command": "remoteSshWebForm.visualizeAtCursor",
        "title": "Visualize as Table",
        "category": "Remote SSH WebForm",
        "icon": "$(table)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "remoteSshWebForm",
        "properties": {
          "action": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      }
    ],
    "configuration": {
      "title": "Remote SSH WebForm",
      "properties": {
        "remoteSshWebForm.configuration": {
          "type": "string",
          "default": "Debug",
          "description": "MSBuild Configuration to build."
        },
        "remoteSshWebForm.platform": {
          "type": "string",
          "default": "AnyCPU",
          "description": "MSBuild Platform to build."
        },
        "remoteSshWebForm.solutionPlatform": {
          "type": "string",
          "default": "Any CPU",
          "description": "Solution platform for Build Solution (solution platforms are named like \"Any CPU\", unlike the project platform \"AnyCPU\")."
        },
        "remoteSshWebForm.restoreBeforeSolutionBuild": {
          "type": "boolean",
          "default": true,
          "description": "Restore NuGet packages (including packages.config projects) as part of Build Solution."
        },
        "remoteSshWebForm.debugType": {
          "type": "string",
          "default": "portable",
          "description": "MSBuild DebugType. The VS Code 'clr' debugger needs portable PDBs."
        },
        "remoteSshWebForm.buildProjectReferences": {
          "type": "boolean",
          "default": false,
          "description": "Also build referenced projects. Off by default so unrelated breakage elsewhere in the solution can't block a debug session; referenced assemblies must then already exist from a prior solution build."
        },
        "remoteSshWebForm.buildChangedReferences": {
          "type": "boolean",
          "default": true,
          "description": "Before building the profile's projects, build the projects they reference (directly or indirectly) whose files changed since their last build, dependencies first. Unchanged references aren't built. Not needed when buildProjectReferences is on."
        },
        "remoteSshWebForm.buildBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Build the profile's projects before Run/Debug."
        },
        "remoteSshWebForm.additionalMsbuildArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments appended to every MSBuild invocation."
        },
        "remoteSshWebForm.msbuildPath": {
          "type": "string",
          "default": "",
          "description": "Full path to MSBuild.exe. Empty = locate via vswhere."
        },
        "remoteSshWebForm.iisExpressPath": {
          "type": "string",
          "default": "",
          "description": "Full path to iisexpress.exe. Empty = %ProgramFiles%\\IIS Express\\iisexpress.exe."
        },
        "remoteSshWebForm.applicationPool": {
          "type": "string",
          "enum": [
            "Clr4IntegratedAppPool",
            "Clr4ClassicAppPool"
          ],
          "default": "Clr4IntegratedAppPool",
          "description": "IIS Express application pool for the generated sites."
        },
        "remoteSshWebForm.bindAllHostnames": {
          "type": "boolean",
          "default": true,
          "description": "Bind sites to all hostnames (\"*:<port>:\") so they answer on the machine's IP/hostname, not only localhost. Needs a URL reservation when VS Code isn't elevated; the extension tries to add one."
        },
        "remoteSshWebForm.justMyCode": {
          "type": "boolean",
          "default": true,
          "description": "Debugger 'Just My Code' setting."
        },
        "remoteSshWebForm.stopSitesWhenDebuggingStops": {
          "type": "boolean",
          "default": true,
          "description": "Stop the IIS Express sites once every debug session started by Debug Profile has ended."
        },
        "remoteSshWebForm.startupTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "How long to wait for each IIS Express site to report it is running."
        },
        "remoteSshWebForm.generateDesignerOnSave": {
          "type": "boolean",
          "default": true,
          "description": "When an .aspx, .ascx or .master file is saved, update its .designer.cs/.vb with a field for each server control, as Visual Studio does."
        },
        "remoteSshWebForm.tableVisualizer.maxRows": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 100000,
          "description": "Most rows Visualize as Table reads per table or collection. The total count is still shown. Large values make reading and rendering slower."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "remoteSshWebForm.generateDesigner",
          "when": "resourceExtname =~ /^.(aspx|ascx|master)$/i",
          "group": "7_modification"
        }
      ],
      "editor/context": [
        {
          "command": "remoteSshWebForm.generateDesigner",
          "when": "resourceExtname =~ /^.(aspx|ascx|master)$/i",
          "group": "1_modification"
        },
        {
          "command": "remoteSshWebForm.toggleCodeBehind",
          "when": "resourceFilename =~ /\\.(aspx|ascx|master|asmx|ashx|asax)(\\.designer)?(\\.(cs|vb))?$/i",
          "group": "navigation"
        },
        {
          "command": "remoteSshWebForm.visualizeAtCursor",
          "when": "debugState == 'stopped' && debugType =~ /^(clr|coreclr)$/ && editorLangId =~ /^(csharp|vb)$/",
          "group": "debug@10"
        }
      ],
      "debug/variables/context": [
        {
          "command": "remoteSshWebForm.visualizeVariable",
          "when": "debugType =~ /^(clr|coreclr)$/ && variableEvaluateNamePresent && variableType =~ /DataTable|DataSet|DataView|\\[,*\\]|List|Dictionary|Collection|Enumerable|Queryable|Set<|Queue<|Stack<|Array|Hashtable|Lookup|Iterator|Bag</",
          "group": "z_commands"
        },
        {
          "command": "remoteSshWebForm.visualizeVariable",
          "when": "debugType =~ /^(clr|coreclr)$/ && variableEvaluateNamePresent && variableType =~ /DataTable|DataSet|DataView|\\[,*\\]|List|Dictionary|Collection|Enumerable|Queryable|Set<|Queue<|Stack<|Array|Hashtable|Lookup|Iterator|Bag</",
          "group": "inline"
        }
      ],
      "debug/watch/context": [
        {
          "command": "remoteSshWebForm.visualizeVariable",
          "when": "debugType =~ /^(clr|coreclr)$/ && variableType =~ /DataTable|DataSet|DataView|\\[,*\\]|List|Dictionary|Collection|Enumerable|Queryable|Set<|Queue<|Stack<|Array|Hashtable|Lookup|Iterator|Bag</",
          "group": "z_commands"
        }
      ],
      "commandPalette": [
        {
          "command": "remoteSshWebForm.toggleCodeBehind",
          "when": "resourceFilename =~ /\\.(aspx|ascx|master|asmx|ashx|asax)(\\.designer)?(\\.(cs|vb))?$/i"
        },
        {
          "command": "remoteSshWebForm.visualizeVariable",
          "when": "false"
        },
        {
          "command": "remoteSshWebForm.visualizeAtCursor",
          "when": "false"
        },
        {
          "command": "remoteSshWebForm.visualizeExpression",
          "when": "inDebugMode && debugType =~ /^(clr|coreclr)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "remoteSshWebForm.toggleCodeBehind",
        "key": "f7",
        "when": "editorTextFocus && resourceFilename =~ /\\.(aspx|ascx|master|asmx|ashx|asax)(\\.designer)?(\\.(cs|vb))?$/i"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run compile:debuggee",
    "compile:debuggee": "dotnet build debuggee/TableVisualizer.Debuggee.csproj -c Release -nologo -v q",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\"",
    "package": "vsce package --skip-license --allow-missing-repository --baseContentUrl https://github.com/ariitx/Remote-SSH-Webform/blob/main"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
